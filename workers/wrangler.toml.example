# TEMPLATE — copy to `wrangler.toml` and fill in your own ids:
#
#     cp workers/wrangler.toml.example workers/wrangler.toml
#     wrangler d1 create loft-db     # or: wrangler d1 list
#     # paste the uuid into database_id below
#
# The real `wrangler.toml` is gitignored because `database_id` identifies a
# specific database in a specific account, and this repo is public.
#
# KEEP THIS FILE IN STEP: bindings live in wrangler.toml, which git no longer
# sees, so any binding you add there must be mirrored here or a fresh clone
# deploys a Worker missing it.

name = "loft-api"
main = "src/index.ts"
compatibility_date = "2024-11-27"
compatibility_flags = ["nodejs_compat"]

# account_id is read from the CLOUDFLARE_ACCOUNT_ID env var, or auto-detected
# from `wrangler login`. Uncomment + set it only if you have multiple accounts:
# account_id = "<your-cloudflare-account-id>"

[vars]
ENV = "prod"

# NOTE: ALLOWED_EMAILS is deliberately NOT here.
#
# It is set as an encrypted secret instead, because this file is committed to a
# public repo and the list contains real personal addresses:
#
#     wrangler secret put ALLOWED_EMAILS
#     # then paste:  you@example.com,partner@example.com
#
# It must be a *secret*, not a dashboard "Variable": `wrangler deploy` replaces
# the plaintext vars bag with whatever is in this file, so a variable edited in
# the dashboard is wiped on the next deploy. Secrets survive deploys.
#
# ORDER IS LOAD-BEARING ON FIRST DEPLOY: the first email becomes user "u1", who
# migration 0003 assigns every pre-existing photo and album to. Put your own
# address first. Once both people have logged in, order stops mattering.
#
# The Cloudflare Access policy is a separate, independent gate and must list both
# addresses too, or the second person never reaches the Worker at all.
#
# For local dev, `workers/.dev.vars` (gitignored) supplies it instead.

[assets]
directory = "../web/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "loft"
preview_bucket_name = "loft-preview"

[[d1_databases]]
binding = "DB"
database_name = "loft-db"
# Paste the id printed by `wrangler d1 create loft-db` here.
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"

[triggers]
crons = ["0 3 * * *"]
